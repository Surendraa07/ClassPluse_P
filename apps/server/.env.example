# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins ("*" allows any; mobile apps don't send Origin)
CORS_ORIGIN=*

# --- Database ---
# docker-compose default; adjust for a native Postgres install
DATABASE_URL=postgresql://classpluse:classpluse@localhost:5432/classpluse?schema=public
# Used by `npm test` (tables are wiped between tests!)
TEST_DATABASE_URL=postgresql://classpluse:classpluse@localhost:5432/classpluse_test?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Cloudinary (signed uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=classpluse

# --- Tuning (optional) ---
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20
JOIN_RATE_LIMIT=120
BROADCAST_THROTTLE_MS=300
